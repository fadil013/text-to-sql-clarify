# LLM provider: ollama | groq | gemini | openrouter
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Postgres (admin role is used only for schema/seed; the app uses the read-only role)
POSTGRES_DB=shop
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change_me
POSTGRES_READONLY_USER=app_readonly
POSTGRES_READONLY_PASSWORD=change_me_too

# Safety limits
STATEMENT_TIMEOUT_MS=5000
MAX_ROWS=1000
