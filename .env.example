# LLM provider: gemini | groq | ollama  (all free; ollama runs locally with no quota)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://127.0.0.1:11434

# Postgres (admin role is used only for schema/seed; the app uses the read-only role)
POSTGRES_DB=shop
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change_me
POSTGRES_READONLY_USER=app_readonly
POSTGRES_READONLY_PASSWORD=change_me_too

# Safety limits
STATEMENT_TIMEOUT_MS=5000
MAX_ROWS=1000
